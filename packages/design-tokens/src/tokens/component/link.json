              "$type": "color"
            }
          },
          "spacing": {
            "outline": {
              "$value": "{spacing.xxs}",
              "$type": "dimension"
            },
            "outlineOffset": {
              "$value": "{spacing.xs}",
              "$type": "dimension"
            }
          }
